# The API is deployed on Render (https://seco-backend-api.onrender.com) with the
# database on MongoDB Atlas; these values are set in the Render dashboard.
# Copy this file to apps/api/.env only to run the tests or the API yourself.
# Never commit .env (it holds the DB password).

# --- Database -------------------------------------------------------------
# Shared team database (MongoDB Atlas). Ask the DB owner for the URI.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=seco
MONGO_DATABASE=seco

# --- Auth -----------------------------------------------------------------
# Must be the same on every API instance that shares the database.
JWT_SECRET=change-me-to-a-long-random-string

# --- MQTT -----------------------------------------------------------------
# The broker the stations use (hardware/station, simulator/station).
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
# Unique per running API, otherwise brokers kick the older connection.
MQTT_CLIENT_ID=seco-api-yourname
# Every API on the same broker must use the same group, so a station request
# (RFID scan, session start...) is handled by exactly one of them.
MQTT_SHARE_GROUP=seco-api
# Admin desk RFID reader used to give members their card (simulator/admin).
ADMIN_READER_ID=READER-01

# --- Features -------------------------------------------------------------
DEMO_TOPUP_ENABLED=false
# The web app on Vercel serves the guest payment page.
WEB_ORIGIN=https://iad-seco.vercel.app
GUEST_PAYMENT_URL_BASE=https://iad-seco.vercel.app/pay
