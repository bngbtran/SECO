{
  "version": 1,
  "author": "SECO team - admin desk RFID reader",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": -140,
      "left": 150,
      "attrs": { "pins": "i2c", "i2cAddress": "0x27" }
    },
    {
      "type": "board-mfrc522",
      "id": "rfid",
      "top": 40,
      "left": 260,
      "attrs": { "uid": "A1:B2:C3:D4" }
    },
    { "type": "wokwi-led", "id": "ledOnline", "top": 250, "left": -120, "attrs": { "color": "green", "label": "ONLINE" } },
    { "type": "wokwi-led", "id": "ledWait", "top": 250, "left": -80, "attrs": { "color": "yellow", "label": "WAIT" } },
    { "type": "wokwi-led", "id": "ledError", "top": 250, "left": -40, "attrs": { "color": "red", "label": "ERROR" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 320, "left": -130, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 320, "left": -90, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 320, "left": -50, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "lcd:GND", "esp:GND.1", "black", [] ],
    [ "lcd:VCC", "esp:5V", "red", [] ],
    [ "lcd:SDA", "esp:8", "blue", [] ],
    [ "lcd:SCL", "esp:9", "gold", [] ],

    [ "rfid:3.3V", "esp:3V3.1", "red", [] ],
    [ "rfid:GND", "esp:GND.2", "black", [] ],
    [ "rfid:RST", "esp:14", "white", [] ],
    [ "rfid:SDA", "esp:10", "orange", [] ],
    [ "rfid:MOSI", "esp:11", "green", [] ],
    [ "rfid:SCK", "esp:12", "purple", [] ],
    [ "rfid:MISO", "esp:13", "blue", [] ],

    [ "esp:15", "ledOnline:A", "green", [] ],
    [ "ledOnline:C", "r1:1", "black", [] ],
    [ "r1:2", "esp:GND.1", "black", [] ],
    [ "esp:16", "ledWait:A", "gold", [] ],
    [ "ledWait:C", "r2:1", "black", [] ],
    [ "r2:2", "esp:GND.1", "black", [] ],
    [ "esp:17", "ledError:A", "red", [] ],
    [ "ledError:C", "r3:1", "black", [] ],
    [ "r3:2", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
